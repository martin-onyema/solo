# ============================================================================
# Supabase PostgreSQL Connection Strings
# ============================================================================
# POOLED connection (for runtime queries) — uses PgBouncer on port 6543
DATABASE_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# DIRECT connection (for Prisma CLI: migrate, db push) — port 5432
DIRECT_URL="postgresql://postgres.[YOUR-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================================
# Auth.js (NextAuth) Secret
# Generate one: npx auth secret
# ============================================================================
AUTH_SECRET="your-auth-secret-here-generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# ============================================================================
# Admin Seed Password (used by prisma/seed.ts)
# ============================================================================
ADMIN_DEFAULT_PASSWORD="solo2024"
